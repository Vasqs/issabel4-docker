#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="${NEWIVR_KEYCLOAK_ENV_FILE:-/etc/newivr/keycloak.env}"
BASE_DIR="${NEWIVR_KEYCLOAK_BASE_DIR:-/opt/newivr/keycloak}"
RUN_DIR="${NEWIVR_KEYCLOAK_RUN_DIR:-/var/run/newivr}"
LOG_DIR="${NEWIVR_KEYCLOAK_LOG_DIR:-/var/log/newivr}"
PID_FILE="${RUN_DIR}/keycloak.pid"
LOG_FILE="${LOG_DIR}/keycloak.log"

newivr_env_value() {
  local name="$1"
  local default="$2"
  local value=""

  if [ -r "$ENV_FILE" ]; then
    value="$(awk -F= -v key="$name" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE")"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
  fi

  if [ -n "$value" ]; then
    printf '%s\n' "$value"
  else
    printf '%s\n' "$default"
  fi
}

KEYCLOAK_HTTP_HOST="${NEWIVR_KEYCLOAK_HTTP_HOST:-$(newivr_env_value NEWIVR_KEYCLOAK_HTTP_HOST 127.0.0.1)}"
KEYCLOAK_HTTP_BIND_HOST="${NEWIVR_KEYCLOAK_HTTP_BIND_HOST:-$(newivr_env_value NEWIVR_KEYCLOAK_HTTP_BIND_HOST "$KEYCLOAK_HTTP_HOST")}"
KEYCLOAK_HTTP_PORT="${NEWIVR_KEYCLOAK_HTTP_PORT:-$(newivr_env_value NEWIVR_KEYCLOAK_HTTP_PORT 18080)}"
KEYCLOAK_ISSUER="${NEWIVR_KEYCLOAK_ISSUER:-$(newivr_env_value NEWIVR_KEYCLOAK_ISSUER "http://${KEYCLOAK_HTTP_HOST}:${KEYCLOAK_HTTP_PORT}/realms/newivr")}"
KEYCLOAK_INTERNAL_BASE_URL="${NEWIVR_KEYCLOAK_INTERNAL_BASE_URL:-$(newivr_env_value NEWIVR_KEYCLOAK_INTERNAL_BASE_URL "http://${KEYCLOAK_HTTP_HOST}:${KEYCLOAK_HTTP_PORT}")}"
KEYCLOAK_HOSTNAME="${NEWIVR_KEYCLOAK_HOSTNAME:-$(newivr_env_value NEWIVR_KEYCLOAK_HOSTNAME "")}"
KEYCLOAK_PROXY_HEADERS="${NEWIVR_KEYCLOAK_PROXY_HEADERS:-$(newivr_env_value NEWIVR_KEYCLOAK_PROXY_HEADERS "")}"
KEYCLOAK_VERSION="${NEWIVR_KEYCLOAK_VERSION:-$(newivr_env_value NEWIVR_KEYCLOAK_VERSION "")}"
KEYCLOAK_ADMIN_USER="${NEWIVR_KEYCLOAK_ADMIN_USER:-$(newivr_env_value NEWIVR_KEYCLOAK_ADMIN_USER admin)}"
KEYCLOAK_ADMIN_PASSWORD="${NEWIVR_KEYCLOAK_ADMIN_PASSWORD:-$(newivr_env_value NEWIVR_KEYCLOAK_ADMIN_PASSWORD DevKeycloak123)}"
JRE_DIR="${BASE_DIR}/jre"

keycloak_dir() {
  if [ -n "$KEYCLOAK_VERSION" ] && [ -x "${BASE_DIR}/keycloak-${KEYCLOAK_VERSION}/bin/kc.sh" ]; then
    printf '%s\n' "${BASE_DIR}/keycloak-${KEYCLOAK_VERSION}"
    return 0
  fi

  find "$BASE_DIR" -maxdepth 1 -type d -name 'keycloak-*' -print 2>/dev/null | sort -V | tail -n 1
}

keycloak_is_installed() {
  [ -x "${JRE_DIR}/bin/java" ] && [ -x "$(keycloak_dir)/bin/kc.sh" ]
}

keycloak_is_running() {
  curl -fsS "${KEYCLOAK_INTERNAL_BASE_URL}/realms/newivr/.well-known/openid-configuration" >/dev/null 2>&1
}

keycloak_pid() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" >/dev/null 2>&1; then
    cat "$PID_FILE"
    return 0
  fi

  pgrep -f 'keycloak.*start-dev' | head -n 1
}

keycloak_process_matches_config() {
  local pid
  local cmdline

  pid="$(keycloak_pid || true)"
  [ -n "$pid" ] || return 1
  cmdline="$(tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null || true)"

  case "$cmdline" in
    *"--http-host=${KEYCLOAK_HTTP_BIND_HOST}"*"--http-port=${KEYCLOAK_HTTP_PORT}"*) ;;
    *) return 1 ;;
  esac

  if [ -n "$KEYCLOAK_HOSTNAME" ]; then
    case "$cmdline" in *"--hostname=${KEYCLOAK_HOSTNAME}"*) ;; *) return 1 ;; esac
  else
    case "$cmdline" in *"--hostname="*) return 1 ;; esac
  fi

  if [ -n "$KEYCLOAK_PROXY_HEADERS" ]; then
    case "$cmdline" in *"--proxy-headers=${KEYCLOAK_PROXY_HEADERS}"*) ;; *) return 1 ;; esac
  else
    case "$cmdline" in *"--proxy-headers="*) return 1 ;; esac
  fi
}

start_keycloak() {
  local kc_dir
  local current_pid

  if keycloak_is_running && keycloak_process_matches_config; then
    return 0
  fi

  if ! keycloak_is_installed; then
    echo "NewIvr Keycloak is not installed under ${BASE_DIR}; skipping startup"
    return 0
  fi

  mkdir -p "$RUN_DIR" "$LOG_DIR"

  current_pid="$(keycloak_pid || true)"
  if [ -n "$current_pid" ]; then
    kill "$current_pid" >/dev/null 2>&1 || true
    sleep 2
  fi

  kc_dir="$(keycloak_dir)"
  export JAVA_HOME="$JRE_DIR"
  export PATH="${JRE_DIR}/bin:${PATH}"
  export KEYCLOAK_ADMIN="$KEYCLOAK_ADMIN_USER"
  export KEYCLOAK_ADMIN_PASSWORD="$KEYCLOAK_ADMIN_PASSWORD"
  export KC_HTTP_ENABLED=true
  export KC_HOSTNAME_STRICT=false

  local keycloak_args=(
    start-dev
    --import-realm
    --http-host="$KEYCLOAK_HTTP_BIND_HOST"
    --http-port="$KEYCLOAK_HTTP_PORT"
    --hostname-strict=false
  )
  if [ -n "$KEYCLOAK_HOSTNAME" ]; then
    keycloak_args+=(--hostname="$KEYCLOAK_HOSTNAME")
  fi
  if [ -n "$KEYCLOAK_PROXY_HEADERS" ]; then
    keycloak_args+=(--proxy-headers="$KEYCLOAK_PROXY_HEADERS")
  fi

  nohup "${kc_dir}/bin/kc.sh" \
    "${keycloak_args[@]}" \
    >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"

  for _ in $(seq 1 90); do
    if keycloak_is_running; then
      return 0
    fi
    sleep 1
  done

  tail -n 80 "$LOG_FILE" >&2 || true
  return 1
}

stop_keycloak() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" >/dev/null 2>&1; then
    kill "$(cat "$PID_FILE")" >/dev/null 2>&1 || true
  fi
}

case "${1:-start}" in
  start)
    start_keycloak
    ;;
  stop)
    stop_keycloak
    ;;
  restart)
    stop_keycloak
    sleep 2
    start_keycloak
    ;;
  status)
    keycloak_is_running
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 2
    ;;
esac
